---
import { Download } from 'lucide-react';
import LangToggle from './LangToggle.astro';
import MobileNav from './MobileNav.astro';
import { SECTIONS, type Lang, type SectionKey } from '../i18n/ui';
import { useTranslations, localizePath, cvPath, cvFilename } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** Se propaga a MobileNav: fija el tab activo donde no hay scroll spy. */
  activeSection?: SectionKey;
}

const { lang, activeSection } = Astro.props;
const t = useTranslations(lang);
const home = localizePath(lang, '/');
---

<header class="topbar" id="topbar">
  <div class="topbar-left">
    <span class="status-dot"></span>
    <span>carlos.volweides</span>
  </div>
  <nav class="topbar-nav">
    {SECTIONS.map(s => (
      <a href={`${home}#${s.id}`} data-section={s.id}>
        <span class="num">{s.num}</span>
        {t.nav[s.key]}
      </a>
    ))}
  </nav>
  <div class="topbar-right">
    <a
      class="cv-btn"
      href={cvPath(lang)}
      download={cvFilename(lang)}
      aria-label={t.header.cvAria}
    >
      <Download size={12} strokeWidth={2} aria-hidden="true" />
      {t.header.cv}
    </a>
    <LangToggle lang={lang} />
    <button class="cmdk-hint" id="cmdk-trigger" aria-label={t.header.cmdk}>
      <kbd>⌘</kbd><kbd>K</kbd>
    </button>
  </div>
</header>

<MobileNav lang={lang} activeSection={activeSection} />

<style>
  .topbar-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Relleno de acento para que sea lo primero que se ve en el topbar,
     que es fijo y también visible en mobile. */
  .cv-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--bg);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 0.25rem;
    padding: 0.1875rem 0.625rem;
    transition: background 0.15s, color 0.15s;
  }
  .cv-btn:hover {
    background: transparent;
    color: var(--accent);
  }
  .cv-btn:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 2px;
  }
</style>

<script>
  // Scroll spy — marks active nav link based on visible section.
  // Cubre el nav del topbar (desktop) y la barra inferior (mobile) a la vez.
  const links = document.querySelectorAll<HTMLAnchorElement>('a[data-section]');

  const setActive = (id: string) => {
    links.forEach(a => {
      a.classList.toggle('active', a.dataset.section === id);
    });
  };

  const obs = new IntersectionObserver(
    entries => {
      entries.forEach(e => { if (e.isIntersecting) setActive(e.target.id); });
    },
    { rootMargin: '-30% 0px -60% 0px' }
  );

  document.querySelectorAll('section[id]').forEach(el => obs.observe(el));
</script>
