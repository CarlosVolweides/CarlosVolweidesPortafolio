---
import { LOCALES, type Lang } from '../i18n/ui';
import { useTranslations, alternatePaths, fmt } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Same page in every locale. The cookie is written on click so a manual choice
// always outranks the middleware's Accept-Language / geo detection on later visits.
const paths = alternatePaths(Astro.url.pathname);
---

<div class="lang-toggle">
  {LOCALES.map((l, i) => (
    <>
      {i > 0 && <span class="lang-sep">/</span>}
      <a
        class:list={['lang-opt', { active: l === lang }]}
        href={paths[l]}
        data-lang={l}
        aria-current={l === lang ? 'true' : undefined}
        aria-label={fmt(t.header.switchTo, { lang: t.header.langNames[l] })}
      >{l.toUpperCase()}</a>
    </>
  ))}
</div>

<style>
  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--fg-dim);
    border: 1px solid var(--line-strong);
    border-radius: 0.25rem;
    padding: 0.125rem 0.4375rem;
    transition: border-color 0.15s;
  }
  .lang-toggle:hover { border-color: var(--fg-dim); }
  .lang-sep { color: var(--line-strong); }
  .lang-opt { color: inherit; transition: color 0.15s; }
  .lang-opt:hover { color: var(--fg); }
  .lang-opt.active { color: var(--accent); }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.lang-toggle .lang-opt').forEach(opt => {
    opt.addEventListener('click', () => {
      const lang = opt.dataset.lang;
      if (lang) {
        document.cookie = `lang=${lang}; path=/; max-age=31536000; SameSite=Lax`;
      }
    });
  });
</script>
